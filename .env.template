# Copy this file to .env and fill in every value below.
# Nothing here is optional: the Compose file and the admin scripts fail fast
# when a setting is missing or empty. Never commit .env.

# ---------------------------------------------------------------------------
# Credentials — generate each with: openssl rand -base64 32
# ---------------------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# pgAdmin
# ---------------------------------------------------------------------------
# Login email (username) for the pgAdmin web UI
PGADMIN_DEFAULT_EMAIL=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Tailscale IP of THIS host (the machine running Docker).
# PostgreSQL (5432), postgres-exporter (9187) and pgAdmin (8088) are published
# on this address only. It is also the upstream address in vps/nginx-stream.conf.
TAILSCALE_IP=

# Host that local admin scripts (Makefile, scripts/*.sh) connect to.
# Usually the same as TAILSCALE_IP; a DNS name is fine too.
DB_HOST=
DB_PORT=5432
DB_USER=admin

# ---------------------------------------------------------------------------
# Storage — absolute paths, independent of where the checkout lives
# ---------------------------------------------------------------------------
# PostgreSQL data directory, on fast local storage
PGDATA_DIR=

# Backup destination, on a separate disk or array from PGDATA_DIR
BACKUP_DIR=
